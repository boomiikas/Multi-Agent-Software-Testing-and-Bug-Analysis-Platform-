# Copy this file to .env and change the secrets before running in production.

PORT=4000

# Used to sign JWTs. MUST be a long random string in production.
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=15m

# "Remember me" sessions get a longer-lived token.
JWT_REMEMBER_EXPIRES_IN=30d

# Reset-password tokens expire quickly.
RESET_TOKEN_EXPIRES_IN=15m

# Default admin account, seeded on first run if it doesn't already exist.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_NAME=System Administrator

# Frontend origin allowed to call this API (CORS).
CLIENT_ORIGIN=http://localhost:5173
