# AgentQA Environment Configuration Template
PORT=4000
HOST=0.0.0.0
ENVIRONMENT=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection (Replace with your local instance or MongoDB Atlas URI)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=agentqa
MONGODB_CONNECT_TIMEOUT_MS=5000

# Security (Generate a strong, random secret for production deployments)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN_SECONDS=900
JWT_REMEMBER_EXPIRES_IN_SECONDS=2592000
RESET_TOKEN_EXPIRES_IN_SECONDS=900

# Security & SSRF Policy (Keep False in production; True only for local developer testing)
ALLOW_LOCAL_TEST_TARGETS=false

# Default Administrator Account (Seed configuration for initial boot)
# IMPORTANT: In production, you MUST change these to secure credentials before startup
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change_this_to_a_secure_admin_password
DEFAULT_ADMIN_NAME=System Administrator

